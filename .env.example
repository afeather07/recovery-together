# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — from console.anthropic.com, server-side only.
# Leave blank to run with AI onboarding fully off (keyword fallback only).
ANTHROPIC_API_KEY=

# Hard override: set to "false" to force AI off regardless of the
# app_config database flag (belt-and-suspenders kill switch).
# Leave unset to let the database flag (default: off) decide.
AI_ONBOARDING_ENABLED=

# Cost guardrails for AI onboarding (see COST_AND_AI_POLICY.md)
AI_DAILY_GLOBAL_LIMIT=200
AI_PER_IP_DAILY_LIMIT=5

# Only needed if/when the /admin moderation view is enabled
ADMIN_KEY=
