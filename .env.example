# The site's public URL, used in metadata, sitemap.xml, robots.txt, and
# notification emails. Leave unset to default to the current Vercel URL --
# set this to switch to a custom domain without touching any code.
NEXT_PUBLIC_SITE_URL=

# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — from console.anthropic.com, server-side only.
# Leave blank to run with AI onboarding fully off (keyword fallback only).
ANTHROPIC_API_KEY=

# Hard override: set to "false" to force AI off regardless of the
# app_config database flag (belt-and-suspenders kill switch).
# Leave unset to let the database flag (default: off) decide.
AI_ONBOARDING_ENABLED=

# Cost guardrails for AI onboarding (see COST_AND_AI_POLICY.md)
AI_DAILY_GLOBAL_LIMIT=200
AI_PER_IP_DAILY_LIMIT=5

# Only needed if/when the /admin moderation view is enabled
ADMIN_KEY=

# Email notifications (reply digests + one-time re-engagement email).
# Off by default -- both of these must be set for any email to send.
# Get a free Resend API key at resend.com (100 emails/day, 3,000/month free).
EMAIL_NOTIFICATIONS_ENABLED=
RESEND_API_KEY=

# Optional -- defaults to Resend's shared onboarding@resend.dev sender if
# unset. Set this once you verify a real sending domain in Resend.
NOTIFY_FROM_EMAIL=

# Random secret Vercel Cron sends as a Bearer token so /api/cron/daily-digest
# can't be triggered by anyone else. Generate any random string.
CRON_SECRET=
